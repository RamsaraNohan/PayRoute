        </mxCell>

        <!-- ══ Arrows – Client → Auth ══ -->
        <mxCell id="ar1" value="Firebase ID Token"
          style="endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;"
