          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ar2d" style="endArrow=block;endFill=1;strokeColor=#82b366;"
          edge="1" source="app_pass" target="fn4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ Arrows – PayHere → payhereNotify webhook ══ -->
        <mxCell id="ar3" value="Webhook (HMAC-verified)"
          style="endArrow=block;endFill=1;fontSize=10;strokeColor=#b85450;"
