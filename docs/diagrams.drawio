          edge="1" source="app_cond" target="fb_auth" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══ Arrows – Client → Azure Functions (HTTPS + Bearer token) ══ -->
        <mxCell id="ar2" value="HTTPS + Bearer token"
          style="endArrow=block;endFill=1;fontSize=10;strokeColor=#82b366;"
          edge="1" source="app_pass" target="fn1" parent="1">
          <mxGeometry relative="1" as="geometry">
