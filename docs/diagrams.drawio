  <!-- ═══════════════════════════════════════════════════════════
       PAGE 3 – Fig 3.3  Entity-Relationship Diagram
       ═══════════════════════════════════════════════════════════ -->
  <diagram name="Fig 3.3 - ER Diagram" id="er">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1" page="1"
                  pageScale="1" pageWidth="1654" pageHeight="1169"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ══════════ ENTITY: users ══════════ -->
        <mxCell id="users_h" value="users"
          style="swimlane;fontStyle=1;align=center;startSize=26;
                 fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="220" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="u_id"    value="🔑 userId (PK)"       style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="users_h"><mxGeometry y="26"  width="220" height="26" as="geometry"/></mxCell>
        <mxCell id="u_email" value="email"                 style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="users_h"><mxGeometry y="52"  width="220" height="26" as="geometry"/></mxCell>
        <mxCell id="u_phone" value="phone"                 style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="users_h"><mxGeometry y="78"  width="220" height="26" as="geometry"/></mxCell>
        <mxCell id="u_role"  value="role"                  style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="users_h"><mxGeometry y="104" width="220" height="26" as="geometry"/></mxCell>
        <mxCell id="u_fcm"   value="fcmToken"              style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="users_h"><mxGeometry y="130" width="220" height="26" as="geometry"/></mxCell>
        <mxCell id="u_pass"  value="passwordHash"          style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="users_h"><mxGeometry y="156" width="220" height="26" as="geometry"/></mxCell>

        <!-- ══════════ ENTITY: passengers ══════════ -->
        <mxCell id="pass_h" value="passengers"
          style="swimlane;fontStyle=1;align=center;startSize=26;
                 fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="230" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p_id"     value="🔑 passengerId (PK)"  style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pass_h"><mxGeometry y="26"  width="230" height="26" as="geometry"/></mxCell>
        <mxCell id="p_uid"    value="🔗 userId (FK → users)" style="text;strokeColor=none;fillColor=none;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pass_h"><mxGeometry y="52"  width="230" height="26" as="geometry"/></mxCell>
